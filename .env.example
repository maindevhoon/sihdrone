# Choose one provider credential, then restart npm run dev.
# Browser keys are public: restrict Google key to your allowed HTTP referrers
# and the Map Tiles API in Google Cloud. Do not put server secrets here.
VITE_GOOGLE_MAPS_API_KEY=
# Alternative: an ion token with Google Photorealistic 3D Tiles asset access.
VITE_CESIUM_ION_TOKEN=
